# Base domain for the Caddy reverse proxy (the app is served on shopping.$DOMAIN)
DOMAIN=example.com

# Secret for signing JWT tokens. Required in production — generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# Web Push (optional — the push bell is hidden when not set). Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
